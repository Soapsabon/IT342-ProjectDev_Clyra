# Copy this file to "backend/.env" (git-ignored) and fill it in. Spring Boot reads it on startup.

# Absolute path to your Firebase service account JSON. Keep that file OUTSIDE the repo
# (or inside backend/secrets/, which is git-ignored). Never commit it.
# Windows example:  C:/Users/you/secrets/clyra-service-account.json
FIREBASE_CREDENTIALS_PATH=

# Firebase WEB apiKey (Project settings > General > Your apps > apiKey), same as VITE_FIREBASE_API_KEY.
FIREBASE_WEB_API_KEY=

# Frontend origin(s) allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# One-time only: email of an EXISTING Firebase Auth user to promote to the first STAFF account.
# Start the backend once, then remove this line. Ignored if a STAFF account already exists.
BOOTSTRAP_STAFF_EMAIL=
