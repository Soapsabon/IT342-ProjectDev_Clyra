rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles. The document id is the Firebase Auth UID.
    match /users/{uid} {
      // A signed-in user may read ONLY their own profile.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Nobody can create, update or delete profiles from a browser. That means a patient can
      // never change their own role (or anyone else's). All writes go through the Spring Boot
      // backend, which uses the Firebase Admin SDK (the Admin SDK bypasses these rules).
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
